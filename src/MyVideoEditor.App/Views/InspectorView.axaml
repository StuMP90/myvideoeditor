<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyVideoEditor.App.ViewModels"
             xmlns:controls="using:MyVideoEditor.App.Controls"
             x:Class="MyVideoEditor.App.Views.InspectorView"
             x:DataType="vm:ClipInspectorViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="TextBlock.name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Margin" Value="0,-6" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ColorPicker">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="2">
    <TextBlock Text="{Binding Heading}" Classes="h2" Margin="0,4,0,6" />
    <TextBox Text="{Binding Name}" Watermark="Clip name" />
    <TextBlock Text="{Binding SourceText}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsMedia}" Margin="0,4,0,0" />

    <!-- Timing -->
    <TextBlock Text="TIMING" Classes="section" />
    <Grid Classes="row" ColumnDefinitions="90,*">
      <TextBlock Classes="name" Text="Starts at" />
      <TextBox Grid.Column="1" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="e.g. 01:23.50 (press Tab to apply)" />
    </Grid>
    <Grid Classes="row" ColumnDefinitions="90,*">
      <TextBlock Classes="name" Text="Length" />
      <TextBox Grid.Column="1" Text="{Binding DurationText, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="How long the clip lasts" />
    </Grid>
    <Grid Classes="row" ColumnDefinitions="90,*,48">
      <TextBlock Classes="name" Text="Fade in" />
      <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxFade}" Value="{Binding FadeIn}" SmallChange="0.1" />
      <TextBlock Grid.Column="2" Classes="value" Text="{Binding FadeIn, StringFormat='{}{0:0.0} s'}" />
    </Grid>
    <Grid Classes="row" ColumnDefinitions="90,*,48">
      <TextBlock Classes="name" Text="Fade out" />
      <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxFade}" Value="{Binding FadeOut}" SmallChange="0.1" />
      <TextBlock Grid.Column="2" Classes="value" Text="{Binding FadeOut, StringFormat='{}{0:0.0} s'}" />
    </Grid>
    <Grid Classes="row" ColumnDefinitions="90,*" ToolTip.Tip="How this clip comes in from the clip before it on the same track (they must touch)">
      <TextBlock Classes="name" Text="Transition" />
      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ClipInspectorViewModel.TransitionStyles}" SelectedIndex="{Binding TransitionStyleIndex}"
                HorizontalAlignment="Stretch" MaxDropDownHeight="400" />
    </Grid>
    <Grid Classes="row" ColumnDefinitions="90,*" IsVisible="{Binding TransitionHasDirection}"
          ToolTip.Tip="Which way the edge moves: Left brings the new clip in from the right">
      <TextBlock Classes="name" Text="Direction" />
      <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ClipInspectorViewModel.TransitionDirections}" SelectedIndex="{Binding TransitionDirectionIndex}"
                HorizontalAlignment="Stretch" />
    </Grid>
    <Grid Classes="row" ColumnDefinitions="90,*,48" ToolTip.Tip="How long the transition lasts (0 = a straight cut)">
      <TextBlock Classes="name" Text="Length" />
      <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MaxFade}" Value="{Binding TransitionIn}" SmallChange="0.1" />
      <TextBlock Grid.Column="2" Classes="value" Text="{Binding TransitionIn, StringFormat='{}{0:0.0} s'}" />
    </Grid>
    <TextBlock IsVisible="{Binding DissolveHasNoPartner}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,0,0,6"
               Text="No clip ends where this one starts on its track, so there's nothing to transition from. Right-click the clip → Add transition to join it to the clip before it." />
    <Grid Classes="row" ColumnDefinitions="90,*,48" IsVisible="{Binding IsVisual}">
      <TextBlock Classes="name" Text="Opacity" />
      <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Opacity}" />
      <TextBlock Grid.Column="2" Classes="value" Text="{Binding Opacity, StringFormat='{}{0:0}%'}" />
    </Grid>

    <!-- Sound and speed -->
    <StackPanel IsVisible="{Binding HasSound}">
      <TextBlock Text="SOUND" Classes="section" />
      <Grid Classes="row" ColumnDefinitions="90,*,48">
        <TextBlock Classes="name" Text="Volume" />
        <Slider Grid.Column="1" Minimum="0" Maximum="400" Value="{Binding Volume}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding Volume, StringFormat='{}{0:0}%'}" />
      </Grid>
      <CheckBox Content="Mute this clip's sound" IsChecked="{Binding AudioMuted}" IsVisible="{Binding OnVideoTrack}" />
    </StackPanel>
    <StackPanel IsVisible="{Binding CanChangeSpeed}">
      <TextBlock Text="SPEED" Classes="section" />
      <Grid Classes="row" ColumnDefinitions="90,*">
        <TextBlock Classes="name" Text="Speed" />
        <NumericUpDown Grid.Column="1" Minimum="0.1" Maximum="16" Increment="0.25" Value="{Binding Speed}" FormatString="0.##'×'" />
      </Grid>
      <TextBlock Text="Faster clips get shorter; sound keeps its pitch." Classes="muted" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Position (video and images) -->
    <StackPanel IsVisible="{Binding ShowsTransform}">
      <DockPanel Margin="0,10,0,4">
        <Button DockPanel.Dock="Right" Classes="tool" Content="Reset" Command="{Binding ResetTransformCommand}" FontSize="11" />
        <TextBlock Text="POSITION AND SIZE" Classes="section" Margin="0" VerticalAlignment="Center" />
      </DockPanel>
      <Grid Classes="row" ColumnDefinitions="90,*">
        <TextBlock Classes="name" Text="Fit" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ClipInspectorViewModel.FitModes}" SelectedItem="{Binding Fit}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Fit: whole picture, with bars. Fill: cover the frame, cropping edges. Stretch: ignore shape. Original: pixel size." />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,48">
        <TextBlock Classes="name" Text="Scale" />
        <Slider Grid.Column="1" Minimum="5" Maximum="400" Value="{Binding Scale}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding Scale, StringFormat='{}{0:0}%'}" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,*">
        <TextBlock Classes="name" Text="Offset X / Y" ToolTip.Tip="Or drag it in the preview" />
        <NumericUpDown Grid.Column="1" Value="{Binding OffsetX}" Increment="10" FormatString="0" Margin="0,0,4,0" />
        <NumericUpDown Grid.Column="2" Value="{Binding OffsetY}" Increment="10" FormatString="0" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,48">
        <TextBlock Classes="name" Text="Rotation" />
        <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding Rotation}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding Rotation, StringFormat='{}{0:0}°'}" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,*" RowDefinitions="Auto,Auto">
        <TextBlock Classes="name" Text="Crop L / R" />
        <NumericUpDown Grid.Column="1" Value="{Binding CropLeft}" Minimum="0" Increment="10" FormatString="0" Margin="0,0,4,4" />
        <NumericUpDown Grid.Column="2" Value="{Binding CropRight}" Minimum="0" Increment="10" FormatString="0" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" Classes="name" Text="Crop T / B" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CropTop}" Minimum="0" Increment="10" FormatString="0" Margin="0,0,4,0" />
        <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding CropBottom}" Minimum="0" Increment="10" FormatString="0" />
      </Grid>
    </StackPanel>

    <!-- Titles -->
    <StackPanel IsVisible="{Binding IsTitle}" Spacing="2">
      <TextBlock Text="TEXT" Classes="section" />
      <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
      <Grid Classes="row" ColumnDefinitions="90,*">
        <TextBlock Classes="name" Text="Font" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ClipInspectorViewModel.Fonts}" SelectedItem="{Binding FontFamily}" HorizontalAlignment="Stretch" MaxDropDownHeight="400" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,48">
        <TextBlock Classes="name" Text="Size" />
        <Slider Grid.Column="1" Minimum="10" Maximum="300" Value="{Binding FontSize}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding FontSize, StringFormat='{}{0:0}'}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2">
        <CheckBox Content="Bold" IsChecked="{Binding Bold}" />
        <CheckBox Content="Italic" IsChecked="{Binding Italic}" />
        <CheckBox Content="Shadow" IsChecked="{Binding Shadow}" />
      </StackPanel>
      <Grid Classes="row" ColumnDefinitions="90,*">
        <TextBlock Classes="name" Text="Align" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ClipInspectorViewModel.Alignments}" SelectedItem="{Binding Alignment}" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*">
        <TextBlock Classes="name" Text="Colour" />
        <ColorPicker Grid.Column="1" Color="{Binding TextColor}" IsAlphaEnabled="False" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,Auto">
        <TextBlock Classes="name" Text="Outline" />
        <Slider Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding OutlineWidth}" />
        <ColorPicker Grid.Column="2" Color="{Binding OutlineColor}" IsAlphaEnabled="False" Margin="6,0,0,0" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,Auto">
        <CheckBox Content="Box" IsChecked="{Binding HasBox}" ToolTip.Tip="A box behind the text, for readability" />
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding BoxOpacity}" IsEnabled="{Binding HasBox}" />
        <ColorPicker Grid.Column="2" Color="{Binding BoxColor}" IsAlphaEnabled="False" IsEnabled="{Binding HasBox}" Margin="6,0,0,0" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="*,Auto">
        <CheckBox Content="Fill the frame (title card)" IsChecked="{Binding HasBackground}" />
        <ColorPicker Grid.Column="1" Color="{Binding BackgroundColor}" IsAlphaEnabled="False" IsEnabled="{Binding HasBackground}" />
      </Grid>
      <TextBlock Text="POSITION" Classes="section" />
      <Grid Classes="row" ColumnDefinitions="90,*,48">
        <TextBlock Classes="name" Text="Across" />
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PositionX}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding PositionX, StringFormat='{}{0:0}%'}" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,48">
        <TextBlock Classes="name" Text="Down" />
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PositionY}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding PositionY, StringFormat='{}{0:0}%'}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="tool" Content="Top" Command="{Binding PlaceTitleCommand}" CommandParameter="top" FontSize="11" />
        <Button Classes="tool" Content="Centre" Command="{Binding PlaceTitleCommand}" CommandParameter="center" FontSize="11" />
        <Button Classes="tool" Content="Lower third" Command="{Binding PlaceTitleCommand}" CommandParameter="lower" FontSize="11" />
        <Button Classes="tool" Content="Bottom" Command="{Binding PlaceTitleCommand}" CommandParameter="bottom" FontSize="11" />
      </StackPanel>
      <TextBlock Text="Tip: drag the title in the preview to move it." Classes="muted" FontSize="11" />
    </StackPanel>

    <!-- Annotations -->
    <StackPanel IsVisible="{Binding IsAnnotation}" Spacing="2">
      <TextBlock Text="ANNOTATION" Classes="section" />
      <Grid Classes="row" ColumnDefinitions="90,*">
        <TextBlock Classes="name" Text="Shape" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ClipInspectorViewModel.Shapes}" SelectedItem="{Binding Shape}" HorizontalAlignment="Stretch" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*" IsVisible="{Binding AnnotationHasColor}">
        <TextBlock Classes="name" Text="Colour" />
        <ColorPicker Grid.Column="1" Color="{Binding TextColor}" IsAlphaEnabled="False" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,48" IsVisible="{Binding AnnotationHasStroke}">
        <TextBlock Classes="name" Text="Line width" />
        <Slider Grid.Column="1" Minimum="1" Maximum="40" Value="{Binding StrokeWidth}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding StrokeWidth, StringFormat='{}{0:0}'}" />
      </Grid>
      <Grid Classes="row" ColumnDefinitions="90,*,48" IsVisible="{Binding AnnotationHasStrength}">
        <TextBlock Classes="name" Text="{Binding StrengthLabel}" />
        <Slider Grid.Column="1" Minimum="1" Maximum="{Binding StrengthMax}" Value="{Binding Strength}" />
        <TextBlock Grid.Column="2" Classes="value" Text="{Binding Strength, StringFormat='{}{0:0}'}" />
      </Grid>
      <StackPanel IsVisible="{Binding AnnotationHasText}" Spacing="2">
        <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Text" />
        <Grid Classes="row" ColumnDefinitions="90,*,48">
          <TextBlock Classes="name" Text="Text size" />
          <Slider Grid.Column="1" Minimum="10" Maximum="160" Value="{Binding FontSize}" />
          <TextBlock Grid.Column="2" Classes="value" Text="{Binding FontSize, StringFormat='{}{0:0}'}" />
        </Grid>
      </StackPanel>
      <TextBlock Text="Drag it in the preview to move it; drag the white handles to resize." Classes="muted" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Effects -->
    <DockPanel Margin="0,12,0,4">
      <Button x:Name="AddEffectButton" DockPanel.Dock="Right" Classes="tool"><StackPanel Classes="iconText"><controls:LineIcon Data="{x:Static controls:Icons.Plus}" /><TextBlock Text="Add effect" /></StackPanel></Button>
      <TextBlock Text="EFFECTS" Classes="section" Margin="0" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock Text="No effects." Classes="muted" FontSize="12" IsVisible="{Binding !HasEffects}" />
    <ItemsControl ItemsSource="{Binding Effects}">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:EffectViewModel">
          <Border Background="#14FFFFFF" CornerRadius="4" Padding="8,6" Margin="0,3">
            <StackPanel Spacing="2">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="tool icon" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove effect"><controls:LineIcon Data="{x:Static controls:Icons.Close}" Size="14" /></Button>
                <Button DockPanel.Dock="Right" Classes="tool icon" Command="{Binding ResetCommand}" ToolTip.Tip="Reset to defaults" Margin="0,0,4,0" IsVisible="{Binding HasParameters}" ><controls:LineIcon Data="{x:Static controls:Icons.Reset}" Size="14" /></Button>
                <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Label}" ToolTip.Tip="{Binding Description}" FontWeight="SemiBold" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:EffectParameterViewModel">
                    <Grid ColumnDefinitions="90,*,56" Margin="0,2">
                      <TextBlock Classes="name" Text="{Binding Label}" />
                      <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" SmallChange="{Binding Step}" IsVisible="{Binding IsNumber}" />
                      <TextBlock Grid.Column="2" Classes="value" Text="{Binding ValueText}" IsVisible="{Binding IsNumber}" />
                      <ColorPicker Grid.Column="1" Color="{Binding ColorValue}" IsAlphaEnabled="False" IsVisible="{Binding IsColor}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
