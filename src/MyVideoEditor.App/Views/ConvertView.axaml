<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyVideoEditor.App.ViewModels"
             xmlns:controls="using:MyVideoEditor.App.Controls"
             x:Class="MyVideoEditor.App.Views.ConvertView"
             x:DataType="vm:ConvertViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*,380">
    <!-- Queue -->
    <Grid Margin="16,12,8,16" RowDefinitions="Auto,Auto,*,5,2*">
      <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
        <TextBlock Text="Convert, resize and upscale" Classes="h1" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Change file formats, make videos bigger or smaller, change the frame rate, trim or rotate. Add files, choose settings on the right, then Convert. Your originals are never changed." />
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <Button Content="＋ Add files…" Command="{Binding AddFilesCommand}" />
        <Button Content="Clear finished" Command="{Binding ClearFinishedCommand}" />
      </StackPanel>
      <Border Grid.Row="2" x:Name="DropZone" Classes="panel" BorderThickness="1" CornerRadius="6">
        <Panel>
          <TextBlock Text="Drop video or audio files here" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" FontSize="15"
                     IsVisible="{Binding !Jobs.Count}" />
          <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Margin="4" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:ConvertJobViewModel">
                  <Border Padding="4,4">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="tool" Content="Show" IsVisible="{Binding IsDone}"
                                Command="{Binding $parent[ListBox].((vm:ConvertViewModel)DataContext).OpenOutputCommand}" CommandParameter="{Binding}" />
                        <Button Classes="tool" Content="✕" IsVisible="{Binding !IsActive}" ToolTip.Tip="Remove from the list"
                                Command="{Binding $parent[ListBox].((vm:ConvertViewModel)DataContext).RemoveJobCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                      <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" />
                        <ProgressBar Value="{Binding Progress}" Maximum="100" IsVisible="{Binding IsActive}" Height="4" MinHeight="4" />
                        <TextBlock Text="{Binding StateText}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </Border>

      <GridSplitter Grid.Row="3" ResizeDirection="Rows" Background="Transparent" />

      <!-- Before / after preview of one frame -->
      <DockPanel Grid.Row="4" Margin="0,6,0,0">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <ToggleButton Classes="tool" Content="Side by side" IsChecked="{Binding PreviewSideBySide}" ToolTip.Tip="Show both whole, or one over the other with a divider to drag" />
              <ComboBox ItemsSource="{Binding PreviewZooms}" SelectedIndex="{Binding PreviewZoom}" MinWidth="80" ToolTip.Tip="Zoom (or use the mouse wheel on the picture); drag to look around" />
            </StackPanel>
            <TextBlock Text="PREVIEW" Classes="section" Margin="0" VerticalAlignment="Center" />
          </DockPanel>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Panel>
              <Button Classes="accent" Content="Preview frame" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanPreview}" IsVisible="{Binding !IsPreviewing}"
                      ToolTip.Tip="Convert just this frame with the current settings and compare it with the original" />
              <Button Content="Cancel preview" Command="{Binding CancelPreviewCommand}" IsVisible="{Binding IsPreviewing}" />
            </Panel>
            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding PreviewDuration}" Value="{Binding PreviewTime}" Margin="10,-6" IsEnabled="{Binding !IsPreviewing}" />
            <TextBlock Grid.Column="2" Text="{Binding PreviewTimeText}" VerticalAlignment="Center" FontFamily="Cascadia Mono, DejaVu Sans Mono, Consolas, monospace" FontSize="12" />
          </Grid>
          <TextBlock Text="{Binding PreviewText}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="The settings or frame have changed: press Preview frame to update." Classes="warning" FontSize="12" IsVisible="{Binding PreviewStale}" />
        </StackPanel>
        <Border Classes="panel" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <controls:ComparisonControl Before="{Binding PreviewBefore}" After="{Binding PreviewAfter}" Overlay="{Binding PreviewOverlay}"
                                      SideBySide="{Binding PreviewSideBySide}" Zoom="{Binding PreviewZoom}" />
        </Border>
      </DockPanel>
    </Grid>

    <!-- Settings -->
    <Border Grid.Column="1" Classes="panel" BorderThickness="1,0,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16" Spacing="8">
          <TextBlock Text="{Binding Status}" Classes="warning" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
            <Button Classes="accent" Content="Convert" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" MinWidth="110" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer>
          <StackPanel Margin="16,12" Spacing="6">
            <TextBlock Text="FORMAT" Classes="section" />
            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="110,*">
              <TextBlock Classes="name" Text="Quality" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality}" HorizontalAlignment="Stretch" IsEnabled="{Binding ReencodeOptionsEnabled}" />
            </Grid>
            <CheckBox IsChecked="{Binding Remux}" Content="Don't re-encode (fast, lossless)"
                      ToolTip.Tip="Copy the video and sound as they are into the new container. Only works when the new format supports the existing codecs; trimming then cuts at the nearest keyframes." />

            <StackPanel IsVisible="{Binding FormatHasVideo}" IsEnabled="{Binding ReencodeOptionsEnabled}" Spacing="6">
              <TextBlock Text="SIZE" Classes="section" />
              <ComboBox ItemsSource="{Binding SizePresets}" SelectedItem="{Binding SizePreset}" HorizontalAlignment="Stretch" />
              <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding IsCustomSize}">
                <TextBox Text="{Binding CustomWidth}" Watermark="Width" />
                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="6,0" />
                <TextBox Grid.Column="2" Text="{Binding CustomHeight}" Watermark="Height" />
              </Grid>
              <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding IsCustomSize}"
                         Text="Leave one empty to keep the shape." />
              <Grid ColumnDefinitions="110,*" IsEnabled="{Binding ResizeEnabled}">
                <TextBlock Classes="name" Text="Shape" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ResizeModes}" SelectedItem="{Binding ResizeMode}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Fit: add black bars. Fill: crop the edges. Stretch: distort to fit." />
              </Grid>
              <TextBlock Text="UPSCALING" Classes="section" />
              <StackPanel IsEnabled="{Binding ResizeEnabled}" Spacing="6">
                <Grid ColumnDefinitions="110,*">
                  <TextBlock Classes="name" Text="The video is" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ContentTypes}" SelectedItem="{Binding Content}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Camera: people, places, nature. Animation: cartoons, anime, games and screen recordings." />
                </Grid>
                <ComboBox ItemsSource="{Binding Scalings}" SelectedItem="{Binding SelectedScaling}" HorizontalAlignment="Stretch" MaxDropDownHeight="520">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:UpscaleOptionViewModel">
                      <StackPanel Margin="0,2" Opacity="{Binding IsAvailable, Converter={x:Static vm:ConvertViewModel.AvailableOpacity}}">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding ScalingDescription}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <Button Classes="tool" Content="{Binding DownloadLabel}" Command="{Binding DownloadScalingCommand}" IsVisible="{Binding ScalingNeedsDownload}"
                        IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Free, and runs entirely on this computer once downloaded." />
                <Button Classes="tool" Content="Test speed on this PC" Command="{Binding TestSpeedCommand}" IsEnabled="{Binding CanTestSpeed}"
                        ToolTip.Tip="Times each method on a few frames of the first file, estimates the whole job and recommends one. Results are remembered." />
                <TextBlock Text="{Binding SpeedText}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding SpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <TextBlock Text="PICTURE" Classes="section" />
              <Grid ColumnDefinitions="110,*">
                <TextBlock Classes="name" Text="Frame rate" />
                <TextBox Grid.Column="1" Text="{Binding FrameRate}" Watermark="Same as source" />
              </Grid>
              <Grid ColumnDefinitions="110,*">
                <TextBlock Classes="name" Text="Rotate" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Rotations}" SelectedItem="{Binding Rotate}" HorizontalAlignment="Stretch" />
              </Grid>
              <CheckBox IsChecked="{Binding Deinterlace}" Content="Deinterlace (old TV / camcorder footage)" />
            </StackPanel>

            <TextBlock Text="TRIM" Classes="section" />
            <Grid ColumnDefinitions="*,Auto,*">
              <TextBox Text="{Binding TrimStart}" Watermark="From (e.g. 0:05)" />
              <TextBlock Grid.Column="1" Text="–" VerticalAlignment="Center" Margin="6,0" />
              <TextBox Grid.Column="2" Text="{Binding TrimEnd}" Watermark="To (end)" />
            </Grid>
            <CheckBox IsChecked="{Binding RemoveAudio}" Content="Remove the sound" IsVisible="{Binding FormatHasVideo}" />

            <TextBlock Text="SAVE TO" Classes="section" />
            <TextBlock Text="{Binding OutputFolderText}" TextWrapping="Wrap" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="tool" Content="Choose folder…" Command="{Binding ChooseFolderCommand}" />
              <Button Classes="tool" Content="Next to each file" Command="{Binding SameFolderCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
