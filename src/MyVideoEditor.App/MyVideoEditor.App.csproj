<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyVideoEditor.App</RootNamespace>
    <AssemblyName>myvideoeditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\myvideoeditor.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Preview audio output. OpenAL Soft is bundled for Windows and Linux. -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <!--
    DirectML.dll for ONNX Runtime's DirectML build (Windows builds; see MyVideoEditor.Core.csproj).
    The Microsoft.AI.DirectML package only copies it into C++ projects, so it's copied here for the
    x64 Windows build (and a plain "dotnet run" on Windows).
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(UseDirectML)' == 'true'">
    <!-- x64 only (the Windows build is x64). -->
    <DirectMLArch Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == ''">x64-win</DirectMLArch>
  </PropertyGroup>
  <ItemGroup Condition="'$(DirectMLArch)' != ''">
    <None Include="$(NuGetPackageRoot)microsoft.ai.directml/1.15.4/bin/$(DirectMLArch)/DirectML.dll"
          Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- onnxruntime.lib is a C++ import library in the ONNX Runtime packages, only for linking native code: never used at run time. -->
  <Target Name="DropOnnxRuntimeLinkerFile" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.lib'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MyVideoEditor.Core\MyVideoEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyVideoEditor.App.Tests" />
  </ItemGroup>
</Project>
