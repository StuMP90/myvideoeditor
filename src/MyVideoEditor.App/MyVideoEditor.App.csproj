<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MyVideoEditor.App</RootNamespace>
    <AssemblyName>myvideoeditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\myvideoeditor.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Preview audio output. OpenAL Soft is bundled for Windows and Linux. -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <!--
    DirectML.dll for ONNX Runtime's DirectML build (Windows builds; see MyVideoEditor.Core.csproj).
    The Microsoft.AI.DirectML package only copies it into C++ projects, so it's copied here for the
    architecture being built (or this computer's, for a plain "dotnet run").
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(UseDirectML)' == 'true'">
    <DirectMLArch Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64-win</DirectMLArch>
    <DirectMLArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64-win</DirectMLArch>
    <DirectMLArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86-win</DirectMLArch>
    <DirectMLArch Condition="'$(DirectMLArch)' == '' and '$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64-win</DirectMLArch>
    <DirectMLArch Condition="'$(DirectMLArch)' == '' and '$(RuntimeIdentifier)' == ''">x64-win</DirectMLArch>
  </PropertyGroup>
  <ItemGroup Condition="'$(DirectMLArch)' != ''">
    <None Include="$(NuGetPackageRoot)microsoft.ai.directml/1.15.4/bin/$(DirectMLArch)/DirectML.dll"
          Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyVideoEditor.Core\MyVideoEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyVideoEditor.App.Tests" />
  </ItemGroup>
</Project>
